{
	"name": "freight-prototype",
	"author": "Alphka",
	"version": "1.0.1",
	"description": "Um site para simular um cálculo do preço do frete da empresa Alphka",
	"scripts": {
		"build": "gulp build",
		"watch": "gulp watch",
		"typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.json --noEmit && tsc -p src/scripts/helpers/tsconfig.json --noEmit"
	},
	"keywords": [
		"Frete",
		"Senai",
		"Simulação"
	],
	"devDependencies": {
		"@types/gulp": "^4.0.18",
		"@types/gulp-sass": "^6.0.0",
		"@types/gulp-uglify": "^3.0.11",
		"@types/node": "^26.6.5",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"glob": "^13.0.6",
		"gulp": "^5.0.1",
		"gulp-sass": "^6.0.1",
		"gulp-typescript": "^6.0.0-alpha.1",
		"gulp-uglify": "^3.0.2",
		"sass": "^1.106.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alphka/Freight-Simulator.git"
	},
	"bugs": {
		"url": "https://github.com/Alphka/Freight-Simulator/issues"
	},
	"homepage": "https://github.com/Alphka/Freight-Simulator#readme",
	"license": "ISC",
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || ^26.3.0"
	},
	"type": "commonjs"
}
